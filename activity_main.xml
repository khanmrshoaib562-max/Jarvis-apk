<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_bg"
    tools:context=".MainActivity">

    <!-- Status Bar -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/status_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/ready"
        android:textColor="@color/status_ready"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- JARVIS Core Animation Container -->
    <FrameLayout
        android:id="@+id/coreContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus">

        <!-- Outer Glow Ring -->
        <View
            android:id="@+id/glowRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/core_glow"
            android:alpha="0.4" />

        <!-- Main Core Circle -->
        <View
            android:id="@+id/coreCircle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/core_circle" />

        <!-- Inner Pulse -->
        <View
            android:id="@+id/innerPulse"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:background="@drawable/core_inner"
            android:alpha="0.7" />

        <!-- Mic Icon Overlay (when listening) -->
        <ImageView
            android:id="@+id/ivMicIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/jarvis_primary"
            android:visibility="gone"
            android:contentDescription="Microphone" />
    </FrameLayout>

    <!-- Chat History RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/inputContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/coreContainer"
        tools:listitem="@layout/item_chat_message" />

    <!-- Input Area -->
    <LinearLayout
        android:id="@+id/inputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/input_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Mic Button -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/mic_button_background"
            android:contentDescription="Voice Mode"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/jarvis_primary"
            android:scaleType="centerInside"
            android:padding="12dp" />

        <!-- Text Input -->
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@android:color/transparent"
            android:hint="@string/type_message"
            android:textColor="@color/jarvis_text"
            android:textColorHint="@color/jarvis_text_secondary"
            android:textSize="15sp"
            android:maxLines="4"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend" />

        <!-- Send Button -->
        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/send"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/jarvis_accent"
            android:padding="10dp" />

        <!-- Stop Button (visible during voice mode) -->
        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stop"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@color/jarvis_error"
            android:padding="10dp"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
